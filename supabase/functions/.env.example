# Edge Function secrets. Copy to supabase/functions/.env for `supabase functions serve` / `npm run evals`,
# and push to the hosted project with: npx supabase secrets set --env-file supabase/functions/.env
OPENAI_API_KEY=
# Extraction model (Responses API + Structured Outputs). Changing it is a secret update, not an app release.
OPENAI_MODEL=gpt-6.1-terra
# low | medium | high, or "off" for models that don't take a reasoning parameter
OPENAI_REASONING_EFFORT=low
# Speech-to-text model
OPENAI_STT_MODEL=gpt-transcribe
# Personal app: comma-separated emails allowed to call the functions. Empty = any signed-in user.
ALLOWED_EMAILS=
# Per-user daily capture cap (cost guard)
MAX_CAPTURES_PER_DAY=50
# google-token: the *Web* OAuth client (same one as Supabase Auth > Providers > Google).
# It turns the stored refresh token into Calendar access tokens.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
