# App config: bundled into the app, so public values ONLY.
# Expo only bundles variables that start with EXPO_PUBLIC_.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Google sign-in needs no app config: Supabase holds the Web client (Auth > Providers > Google)
# and the google-token function holds its secret (supabase/functions/.env).

# Supabase CLI only (never read by the app)
SUPABASE_DB_PASSWORD=

# Server secrets do NOT belong here. They go in supabase/functions/.env (local)
# and `supabase secrets set` (hosted). See supabase/functions/.env.example.
