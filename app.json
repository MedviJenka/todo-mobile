{
  "expo": {
    "name": "Voice To-Do",
    "slug": "todo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "todo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/app.icon",
      "bundleIdentifier": "com.medvijenia.todo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F6FE4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "package": "com.medvijenia.todo"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2F6FE4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Voice To-Do uses the microphone so you can speak your tasks. Audio is sent for transcription and is not stored."
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "2002723f-6d82-407f-9496-7ebeac17dc7d"
      }
    },
    "owner": "medvijenia"
  }
}
